/*.zip
/*.tar
/*.tar.gz
/*.7z
/.codex_*

# Historical generated benchmark logs
/history/test_path_time/*_log*.txt
/exp-dev/**/exp*_lg_*.txt

# Legacy experiment snapshots and raw runs are not required by the adapter.
# Keep them locally, but do not publish embedded credentials or generated audio.
/history/
/exp/
