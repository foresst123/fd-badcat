*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
coverage.xml
htmlcov/

# Local Python environments
.venv/
venv/
env/

# Local secrets; keep distributable templates
.env
.env.*
!.env.example
!.env.*.example

# Notebook, editor and OS metadata
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Downloaded models and local caches
/model/
/models/
/checkpoints/
/.cache/
/huggingface/
/VieNeu-TTS/
/wandb/

# Local service credentials
/.kaggle/
/kaggle.json

# Runtime traces and logs
traces/
/fd-badcat-traces/
*.log
*.pid
*.ses

# Generated realtime/benchmark output
/exp/live/
**/realtimeout*/
/outputs/
/output/
/fd-badcat-*.wav
/fd-badcat-*.pcm
/fd-badcat-*.mp3
/fd-badcat-*.m4a
/fd-badcat-*.json
/.turn*_tts.part
