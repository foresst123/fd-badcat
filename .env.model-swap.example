# Strict FD-BADCAT model-swap baseline (no secrets).
ASR_MODEL_DIR=/kaggle/working/models/zipformer-30m-rnnt-streaming-6000h
ASR_REPO_ID=hynt/Zipformer-30M-RNNT-Streaming-6000h
ASR_EXECUTION_PROVIDER=cuda
ASR_CUDA_DEVICE=0
ASR_CHUNK_SIZE=32
ASR_LEFT_CONTEXT=128
ASR_CPU_THREADS=2
ASR_TAIL_PADDING_MS=660
ASR_LOCAL_FILES_ONLY=false
# Active controller: one decision per continuous VAD speech segment.
# LISTEN uses BUFFER; SPEAK uses interrupt_buf. No fixed one-second Units.
DUPLEX_MODE=vad_segment
# After Silero emits VAD_END, keep the segment open briefly so a natural
# hesitation is joined to the same utterance.
VAD_SEGMENT_ENDPOINT_MS=640
# Continuous user speech while SPEAK gets priority cancellation at 1.5 s.
VAD_LONG_INTERRUPT_SECONDS=1.5
VAD_SPEAK_FALLBACK_SWITCH_SECONDS=0.6
# Upstream FD-BADCAT behavior: after LISTEN + continue, wait for the
# user to resume; if still idle, force L2S and answer after 2.5 seconds.
VAD_LISTEN_CONTINUE_TIMEOUT_SECONDS=2.5
# Native model.as_duplex() is intentionally not used by vad_segment mode.
MLLM_LIVE_PREFILL=0
MLLM_WARMUP_DUPLEX_WRAPPER=0
MLLM_DUPLEX_SYSTEM_PROMPT=Streaming Omni Conversation.
# Override the upstream Chinese/English response policy for Vietnamese runs.
MLLM_RESPONSE_PROMPT_VERSION=vi_benchmark_v1
MLLM_RESPONSE_PROMPT="Luôn trả lời bằng tiếng Việt tự nhiên; làm đúng yêu cầu về nội dung và độ dài; không dùng tiếng Trung, Markdown hoặc thẻ think."

# One JSONL file per WebSocket session. Raw audio/base64 is never written.
TRACE_ENABLED=1
TRACE_DIR=traces
# Enable only for debugging: transcripts and generated text may be sensitive.
TRACE_INCLUDE_TEXT=0
TRACE_MAX_TEXT_CHARS=4000

TTS_URL=http://127.0.0.1:19100
TTS_VOICE=
TTS_TIMEOUT=120
TTS_HEALTH_TIMEOUT=10
TTS_MAX_CONCURRENT_STREAMS=1
TTS_BUSY_RETRIES=12
TTS_BUSY_BACKOFF=0.25
# Warm the real streaming PCM path before any measured conversation.
TTS_WARMUP=1
TTS_WARMUP_TEXT=Xin chào, hệ thống đã sẵn sàng.
# Hybrid phrase streaming: fast first phrase, longer later phrases.
TTS_PHRASE_MIN_CHARS=20
TTS_FIRST_PHRASE_TARGET_CHARS=48
TTS_PHRASE_TARGET_CHARS=72
TTS_PHRASE_MAX_CHARS=140
TTS_FIRST_PHRASE_TIMEOUT_MS=350
TTS_PHRASE_TIMEOUT_MS=500
# Browser reports scheduled, started, drained, or stopped asynchronously.
PLAYBACK_ACK_GRACE_SECONDS=2.0
TTS_API_KEY=
