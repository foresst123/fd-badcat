  <diagram name="02 - LISTEN VAD Segment va fallback">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;b&gt;LISTEN — VAD Segment, streaming ASR, semantic decision và fallback 2.5 giây&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#555555&quot;&gt;Decision N dùng audio hiện tại N + transcript đã cache từ segment N-1; transcript N không được dùng ngược thời gian cho chính decision N&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f4e78;strokeColor=#1f4e78;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;fontColor=#ffffff;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="1860" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Audio frame&lt;/b&gt;&lt;div&gt;PCM16 16 kHz&lt;/div&gt;&lt;div&gt;256 samples = 16 ms&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="190" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Frame accumulator&lt;/b&gt;&lt;div&gt;2 × 256 → 512 samples&lt;/div&gt;&lt;div&gt;Silero window = 32 ms&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="275" y="135" width="220" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Silero VAD&lt;/b&gt;&lt;div&gt;speech probability&lt;/div&gt;&lt;div&gt;start / done events&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="540" y="135" width="205" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b&gt;VAD start?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="790" y="125" width="145" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Mở Segment N&lt;/b&gt;&lt;div&gt;capture state=LISTEN + turn&lt;/div&gt;&lt;div&gt;BUFFER=[]&lt;/div&gt;&lt;div&gt;open Zipformer stream một lần&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="995" y="115" width="255" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Trong khi người dùng nói&lt;/b&gt;&lt;div&gt;frame → BUFFER&lt;/div&gt;&lt;div&gt;frame → accept_waveform()&lt;/div&gt;&lt;div&gt;ASR partial được trace&lt;/div&gt;&lt;div&gt;không chờ decision từng 1 giây&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1305" y="105" width="280" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b&gt;VAD done?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1640" y="125" width="145" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Endpoint grace&lt;/b&gt;&lt;div&gt;đợi 640 ms&lt;/div&gt;&lt;div&gt;lọc khoảng ngừng ngắn&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1450" y="300" width="215" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b&gt;Có speech mới&lt;br&gt;trong 640 ms?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1160" y="295" width="180" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Merge&lt;/b&gt;&lt;div&gt;tiếp tục cùng BUFFER&lt;/div&gt;&lt;div&gt;cùng ASR session&lt;/div&gt;&lt;div&gt;không tạo decision mới&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#38761d;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="865" y="300" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Finalize Segment N&lt;/b&gt;&lt;div&gt;concatenate BUFFER&lt;/div&gt;&lt;div&gt;full-turn audio&lt;/div&gt;&lt;div&gt;finish ASR stream + tail padding 660 ms&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1450" y="445" width="260" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Decision mailbox&lt;/b&gt;&lt;div&gt;asyncio.Queue(maxsize=1)&lt;/div&gt;&lt;div&gt;latest segment only&lt;/div&gt;&lt;div&gt;segment mới thay segment pending cũ&lt;/div&gt;&lt;div&gt;không xếp hàng sau nhiều Unit&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1110" y="455" width="255" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Context đầu vào decision N&lt;/b&gt;&lt;div&gt;audio Segment N — bằng chứng chính&lt;/div&gt;&lt;div&gt;cached ASR transcript N-1 — phụ trợ&lt;/div&gt;&lt;div&gt;không dùng current ASR N&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="745" y="455" width="280" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;MiniCPM decision request&lt;/b&gt;&lt;div&gt;prompt nhận biết state=LISTEN&lt;/div&gt;&lt;div&gt;chỉ sinh một từ&lt;/div&gt;&lt;div&gt;continue hoặc switch&lt;/div&gt;&lt;div&gt;model.chat riêng với response&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="365" y="445" width="285" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b&gt;Output hợp lệ?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="115" y="455" width="170" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Fallback khi inference/parse lỗi&lt;/b&gt;&lt;div&gt;LISTEN → continue (bảo thủ)&lt;/div&gt;&lt;div&gt;SPEAK ≥0.6s → switch&lt;/div&gt;&lt;div&gt;long_interrupt → switch&lt;/div&gt;&lt;div&gt;SPEAK ngắn → continue&lt;/div&gt;&lt;div&gt;không sửa một output hợp lệ nhưng sai&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="660" width="295" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b&gt;Decision&lt;br&gt;trong LISTEN&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="430" y="675" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;continue → KL&lt;/b&gt;&lt;div&gt;Keep Listen&lt;/div&gt;&lt;div&gt;giữ STATE=LISTEN&lt;/div&gt;&lt;div&gt;cache ASR N cho N+1&lt;/div&gt;&lt;div&gt;arm watchdog 2.5s&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="710" y="635" width="250" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;switch → L2S&lt;/b&gt;&lt;div&gt;Listen-to-Speak&lt;/div&gt;&lt;div&gt;STATE=SPEAK&lt;/div&gt;&lt;div&gt;generation mới&lt;/div&gt;&lt;div&gt;khởi động response stream&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#38761d;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="710" y="835" width="250" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="n22" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;LISTEN continue watchdog&lt;/b&gt;&lt;div&gt;VAD_LISTEN_CONTINUE_TIMEOUT_SECONDS=2.5&lt;/div&gt;&lt;div&gt;đếm sau KL ở endpoint&lt;/div&gt;&lt;div&gt;không gọi classifier lần hai&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1040" y="650" width="285" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n23" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b&gt;Sau 2.5s&lt;br&gt;mọi guard còn đúng?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1410" y="645" width="190" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="n24" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Fallback fired&lt;/b&gt;&lt;div&gt;force switch / L2S&lt;/div&gt;&lt;div&gt;decision_source=upstream_continue_timeout&lt;/div&gt;&lt;div&gt;tránh cảm giác treo LISTEN&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1655" y="620" width="230" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="n25" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Watchdog cancelled/skipped&lt;/b&gt;&lt;div&gt;có VAD start mới&lt;/div&gt;&lt;div&gt;khác epoch/index/turn&lt;/div&gt;&lt;div&gt;đang IN_SPEECH&lt;/div&gt;&lt;div&gt;state không còn LISTEN&lt;/div&gt;&lt;div&gt;decision queue không rỗng&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1390" y="835" width="255" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="n26" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;ASR finalize async&lt;/b&gt;&lt;div&gt;transcript N hoàn thành&lt;/div&gt;&lt;div&gt;cache available_from_segment=N+1&lt;/div&gt;&lt;div&gt;không block decision N&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1040" y="845" width="285" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n27" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Response pipeline&lt;/b&gt;&lt;div&gt;MiniCPM text stream → HybridPhraseChunker → VieNeu&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
