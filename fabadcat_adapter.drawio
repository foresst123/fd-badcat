        </mxCell>
        <mxCell id="n21" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;S2L / superseded&lt;/b&gt;&lt;div&gt;close MLLM + current HTTP&lt;/div&gt;&lt;div&gt;clear queues&lt;/div&gt;&lt;div&gt;send stop_audio G&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
