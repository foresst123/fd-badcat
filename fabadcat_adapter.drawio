  <diagram name="03 - SPEAK Barge-in va cancellation">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;b&gt;SPEAK — giám sát barge-in, long-interrupt 1.5 giây và cancellation ưu tiên cao&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#555555&quot;&gt;VAD vẫn chạy khi trợ lý nói để phát hiện giọng người dùng; echo/backchannel được phân biệt bằng semantic decision&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f4e78;strokeColor=#1f4e78;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;fontColor=#ffffff;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="1860" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Effective SPEAK&lt;/b&gt;&lt;div&gt;backend STATE=SPEAK&lt;/div&gt;&lt;div&gt;hoặc browser playback ACK cho biết audio còn phát&lt;/div&gt;&lt;div&gt;generation G đang active&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="135" width="275" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Silero VAD vẫn nghe microphone&lt;/b&gt;&lt;div&gt;VAD start = người dùng/echo/noise bắt đầu có speech&lt;/div&gt;&lt;div&gt;không có nghĩa trợ lý ngừng nói&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="390" y="135" width="300" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Mở interrupt segment&lt;/b&gt;&lt;div&gt;capture observed_state=SPEAK&lt;/div&gt;&lt;div&gt;capture generation=G + turn&lt;/div&gt;&lt;div&gt;interrupt_buf=[]&lt;/div&gt;&lt;div&gt;open streaming ASR&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="760" y="125" width="285" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Thu barge-in&lt;/b&gt;&lt;div&gt;audio frame → interrupt_buf&lt;/div&gt;&lt;div&gt;Zipformer partial song song&lt;/div&gt;&lt;div&gt;đo continuous_speech_duration&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1115" y="135" width="270" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b&gt;Speech liên tục&lt;br&gt;≥ 1.5 giây?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1455" y="130" width="185" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Priority S2L&lt;/b&gt;&lt;div&gt;không đợi VAD endpoint&lt;/div&gt;&lt;div&gt;cancel generation G ngay&lt;/div&gt;&lt;div&gt;STATE→LISTEN; turn++&lt;/div&gt;&lt;div&gt;move interrupt_buf → LISTEN BUFFER&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1690" y="115" width="195" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Nếu ngắn hơn 1.5 giây&lt;/b&gt;&lt;div&gt;VAD done + endpoint grace 640 ms&lt;/div&gt;&lt;div&gt;concatenate interrupt_buf thành Segment N&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1450" y="355" width="255" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;SPEAK semantic decision&lt;/b&gt;&lt;div&gt;audio N + cached ASR N-1&lt;/div&gt;&lt;div&gt;prompt state=SPEAK&lt;/div&gt;&lt;div&gt;continue / switch&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1115" y="350" width="270" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b&gt;continue&lt;br&gt;hay switch?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="830" y="355" width="190" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;continue → KS&lt;/b&gt;&lt;div&gt;Keep Speak&lt;/div&gt;&lt;div&gt;silence/noise/assistant echo&lt;/div&gt;&lt;div&gt;hoặc backchannel ngắn&lt;/div&gt;&lt;div&gt;TTS và generation G tiếp tục&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#38761d;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="320" width="255" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;switch → S2L&lt;/b&gt;&lt;div&gt;Speak-to-Listen&lt;/div&gt;&lt;div&gt;new question/correction/command&lt;/div&gt;&lt;div&gt;request dừng/đổi chủ đề&lt;/div&gt;&lt;div&gt;hủy generation G&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="500" y="510" width="255" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;cancel_active_generation(G)&lt;/b&gt;&lt;div&gt;set cancellation event&lt;/div&gt;&lt;div&gt;generation ID invalidated&lt;/div&gt;&lt;div&gt;new deltas/chunks của G bị bỏ&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="845" y="560" width="290" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;MLLM cancellation&lt;/b&gt;&lt;div&gt;close iterator / request stream&lt;/div&gt;&lt;div&gt;cooperative tại ranh giới text chunk&lt;/div&gt;&lt;div&gt;không preempt CUDA kernel đang chạy&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1220" y="535" width="280" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;VieNeu cancellation&lt;/b&gt;&lt;div&gt;đóng HTTP response/request&lt;/div&gt;&lt;div&gt;giải phóng semaphore&lt;/div&gt;&lt;div&gt;GPU sidecar dừng tức thời chỉ khi server xử lý disconnect&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1220" y="720" width="280" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Browser cancellation&lt;/b&gt;&lt;div&gt;server gửi stop_audio {generation:G}&lt;/div&gt;&lt;div&gt;xả scheduled PCM + Web Audio nodes&lt;/div&gt;&lt;div&gt;ACK stopped trả về bất đồng bộ&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1580" y="535" width="290" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;LISTEN cho lượt mới&lt;/b&gt;&lt;div&gt;giữ audio chen ngang làm đầu vào&lt;/div&gt;&lt;div&gt;VAD/ASR tiếp tục đến endpoint&lt;/div&gt;&lt;div&gt;decision mới không chờ queue cũ&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1580" y="760" width="290" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Generation guards chống race&lt;/b&gt;&lt;div&gt;Mọi delta, phrase, PCM và ACK mang generation ID.&lt;/div&gt;&lt;div&gt;Event của generation cũ bị bỏ nếu active_generation đã đổi.&lt;/div&gt;&lt;div&gt;Snapshot tại VAD start giữ ý nghĩa barge-in dù worker xử lý muộn hơn.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=8;shadow=0;dashed=1;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="730" width="420" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Fallback classifier khi lỗi trong SPEAK&lt;/b&gt;&lt;div&gt;long_interrupt → switch&lt;/div&gt;&lt;div&gt;speech segment ≥ 0.6 s → switch&lt;/div&gt;&lt;div&gt;segment ngắn → continue&lt;/div&gt;&lt;div&gt;Một kết quả hợp lệ continue/switch không bị rule lỗi ghi đè.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=8;shadow=0;dashed=1;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="885" width="420" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n21" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Backend không giao quyền state cho frontend&lt;/b&gt;&lt;div&gt;Backend quyết định LISTEN/SPEAK.&lt;/div&gt;&lt;div&gt;Playback ACK chỉ bổ sung sự thật audio đã scheduled/started/drained/stopped.&lt;/div&gt;&lt;div&gt;effective SPEAK tránh nhận nhầm barge-in thành lượt mới khi browser còn phát.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;align=left;verticalAlign=top;spacing=8;shadow=0;dashed=1;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="845" y="895" width="650" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.7;dashed=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e23" value="VAD start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#555555;strokeWidth=1.7;dashed=0;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry"/>
