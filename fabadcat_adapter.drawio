        <mxCell id="n37" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Timing source of truth&lt;/b&gt;&lt;div&gt;backend: inference/PCM timestamps&lt;/div&gt;&lt;div&gt;browser ACK: actual schedule/start/drain&lt;/div&gt;&lt;div&gt;không dùng ACK để ghi đè semantic state&lt;/div&gt;&lt;div&gt;dùng generation ID để reconcile lệch timing&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#38761d;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
