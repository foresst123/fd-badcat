  <diagram name="04 - Streaming response TTS va playback">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n2" value="&lt;div style=&quot;font-size:24px&quot;&gt;&lt;b&gt;RESPONSE — token/delta streaming → HybridPhraseChunker → VieNeu PCM → browser&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#555555&quot;&gt;Mục tiêu TTFA thấp nhưng không cắt giữa từ; VieNeu hiện dùng một HTTP streaming request cho mỗi phrase&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1f4e78;strokeColor=#1f4e78;strokeWidth=1.5;fontSize=16;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;fontColor=#ffffff;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="18" width="1860" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;response_started&lt;/b&gt;&lt;div&gt;STATE=SPEAK&lt;/div&gt;&lt;div&gt;new generation G&lt;/div&gt;&lt;div&gt;start monotonic timer&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="45" y="145" width="220" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;MiniCPM response stream&lt;/b&gt;&lt;div&gt;request riêng với decision&lt;/div&gt;&lt;div&gt;max_new_tokens=512&lt;/div&gt;&lt;div&gt;do_sample=False&lt;/div&gt;&lt;div&gt;emit assistant_delta&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="330" y="135" width="245" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Delta queue&lt;/b&gt;&lt;div&gt;maxsize=32&lt;/div&gt;&lt;div&gt;backpressure producer&lt;/div&gt;&lt;div&gt;generation-aware&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="640" y="145" width="205" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="n6" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;HybridPhraseChunker&lt;/b&gt;&lt;div&gt;min_chars=20&lt;/div&gt;&lt;div&gt;first target=48; later=72&lt;/div&gt;&lt;div&gt;max_chars=140&lt;/div&gt;&lt;div&gt;first timeout=350 ms&lt;/div&gt;&lt;div&gt;later timeout=500 ms&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="910" y="120" width="265" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="n7" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b&gt;Có safe&lt;br&gt;boundary?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1245" y="140" width="175" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n8" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Emit phrase&lt;/b&gt;&lt;div&gt;ưu tiên . ! ? … / newline&lt;/div&gt;&lt;div&gt;sau đó comma/semicolon/colon&lt;/div&gt;&lt;div&gt;timeout chỉ cắt ở soft/word boundary&lt;/div&gt;&lt;div&gt;không cắt giữa chữ&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#38761d;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1485" y="120" width="275" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="n9" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Chưa có điểm cắt an toàn&lt;/b&gt;&lt;div&gt;giữ buffer&lt;/div&gt;&lt;div&gt;re-arm timeout&lt;/div&gt;&lt;div&gt;đợi delta kế tiếp&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1510" y="330" width="230" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="n10" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Phrase queue&lt;/b&gt;&lt;div&gt;maxsize=2&lt;/div&gt;&lt;div&gt;giới hạn MLLM chạy trước TTS&lt;/div&gt;&lt;div&gt;cancel xả phrase pending của G&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1485" y="505" width="275" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n11" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;VieNeu HTTP request / phrase&lt;/b&gt;&lt;div&gt;POST /v1/audio/speech&lt;/div&gt;&lt;div&gt;stream_format=audio&lt;/div&gt;&lt;div&gt;connect timeout=10 s&lt;/div&gt;&lt;div&gt;read/provider timeout=120 s&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1125" y="495" width="285" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="n12" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b&gt;HTTP 429&lt;br&gt;busy?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="865" y="505" width="175" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n13" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Busy retry&lt;/b&gt;&lt;div&gt;12 retries&lt;/div&gt;&lt;div&gt;backoff 0.25 s exponential&lt;/div&gt;&lt;div&gt;cap 2 s&lt;/div&gt;&lt;div&gt;global Semaphore=1&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="585" y="490" width="220" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="n14" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;PCM stream&lt;/b&gt;&lt;div&gt;PCM16 mono 16 kHz&lt;/div&gt;&lt;div&gt;iter_content chunk=4096 bytes&lt;/div&gt;&lt;div&gt;gửi ngay từng chunk; không đợi WAV hoàn chỉnh&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1125" y="705" width="285" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n15" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Chunk PCM đầu tiên&lt;/b&gt;&lt;div&gt;emit tts_first_audio&lt;/div&gt;&lt;div&gt;metric=backend_first_pcm&lt;/div&gt;&lt;div&gt;TTFA = now - response_started&lt;/div&gt;&lt;div&gt;warmup_included=false&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#70ad47;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="785" y="700" width="260" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="n16" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;WebSocket binary&lt;/b&gt;&lt;div&gt;PCM + generation G&lt;/div&gt;&lt;div&gt;browser schedule Web Audio&lt;/div&gt;&lt;div&gt;chặn chunk của generation cũ&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="460" y="710" width="250" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n17" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Playback ACK&lt;/b&gt;&lt;div&gt;scheduled → started&lt;/div&gt;&lt;div&gt;drained khi nghe hết&lt;/div&gt;&lt;div&gt;stopped khi cancel&lt;/div&gt;&lt;div&gt;ACK bất đồng bộ&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="120" y="700" width="255" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="n18" value="&lt;div style=&quot;text-align:center;line-height:1.25&quot;&gt;&lt;b&gt;Text + phrase + PCM&lt;br&gt;đã drain?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.6;fontSize=12;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="1490" y="720" width="255" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n19" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Playback drain wait&lt;/b&gt;&lt;div&gt;deadline = remaining audio duration&lt;/div&gt;&lt;div&gt;+ PLAYBACK_ACK_GRACE_SECONDS=2.0&lt;/div&gt;&lt;div&gt;backend vẫn effective SPEAK trong lúc browser còn phát&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1445" y="895" width="340" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n20" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;response_finished&lt;/b&gt;&lt;div&gt;tts_stream_end&lt;/div&gt;&lt;div&gt;ACK drained hoặc timeout&lt;/div&gt;&lt;div&gt;STATE→LISTEN nếu không có generation mới&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#38761d;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
