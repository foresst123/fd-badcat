        <mxCell id="n30" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Timeouts / thresholds&lt;/b&gt;&lt;div&gt;VAD endpoint grace: 640 ms&lt;/div&gt;&lt;div&gt;SPEAK long interrupt: 1.5 s&lt;/div&gt;&lt;div&gt;LISTEN false-negative fallback: 2.5 s&lt;/div&gt;&lt;div&gt;classifier error fallback SPEAK threshold: 0.6 s&lt;/div&gt;&lt;div&gt;Hybrid phrase timeout: first 350 ms; later 500 ms&lt;/div&gt;&lt;div&gt;TTS connect/read: 10 s / 120 s&lt;/div&gt;&lt;div&gt;playback ACK grace: 2.0 s&lt;/div&gt;&lt;div&gt;TTS health: 10 s; sidecar startup: 600 s; backend startup: 60 s&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="610" width="420" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="n31" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Queues / concurrency&lt;/b&gt;&lt;div&gt;Decision mailbox: maxsize=1, latest segment only&lt;/div&gt;&lt;div&gt;ASR input/result queue: persistent stream, depth chỉ quan sát&lt;/div&gt;&lt;div&gt;MLLM delta queue: maxsize=32&lt;/div&gt;&lt;div&gt;TTS phrase queue: maxsize=2&lt;/div&gt;&lt;div&gt;VieNeu concurrent streams: Semaphore=1&lt;/div&gt;&lt;div&gt;Busy 429: 12 retries; 0.25 s exponential backoff, cap 2 s&lt;/div&gt;&lt;div&gt;Generation ID chặn event/PCM cũ&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#45818e;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="525" y="610" width="405" height="225" as="geometry"/>
        </mxCell>
        <mxCell id="n32" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Shutdown guards&lt;/b&gt;&lt;div&gt;backend thread join 15 s&lt;/div&gt;&lt;div&gt;VieNeu terminate wait 15 s&lt;/div&gt;&lt;div&gt;kill wait 5 s nếu cần&lt;/div&gt;&lt;div&gt;ports :18000/:19100 verified closed&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="525" y="875" width="405" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="n33" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Per-session trace&lt;/b&gt;&lt;div&gt;TRACE_ENABLED=1&lt;/div&gt;&lt;div&gt;/kaggle/working/fd-badcat-traces&lt;/div&gt;&lt;div&gt;schema fd-badcat.trace.v1&lt;/div&gt;&lt;div&gt;JSONL monotonic timestamps&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#70ad47;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1015" y="615" width="280" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="n34" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Correlated event fields&lt;/b&gt;&lt;div&gt;trace_id, turn, segment&lt;/div&gt;&lt;div&gt;generation, state, flag&lt;/div&gt;&lt;div&gt;decision source, infer time&lt;/div&gt;&lt;div&gt;queue depth, ASR partial/final&lt;/div&gt;&lt;div&gt;TTS/ACK/cancel lifecycle&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#70ad47;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1350" y="605" width="260" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="n35" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Browser Trace UI&lt;/b&gt;&lt;div&gt;conversation timeline&lt;/div&gt;&lt;div&gt;VAD→decision latency&lt;/div&gt;&lt;div&gt;TTFA backend vs playback&lt;/div&gt;&lt;div&gt;queue current/max&lt;/div&gt;&lt;div&gt;cancellation latency&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1670" y="615" width="185" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="n36" value="&lt;div style=&quot;text-align:left;line-height:1.25&quot;&gt;&lt;b&gt;Privacy / debug mode&lt;/b&gt;&lt;div&gt;raw audio và base64 không ghi trace&lt;/div&gt;&lt;div&gt;TRACE_INCLUDE_TEXT=1 trên Kaggle hiện lưu transcript/text&lt;/div&gt;&lt;div&gt;cần tắt hoặc xử lý dữ liệu nhạy cảm khi benchmark thật&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;strokeWidth=1.5;fontSize=13;align=left;verticalAlign=middle;spacing=8;shadow=0;dashed=0;" vertex="1" parent="1">
