# Two-A100 profile for fd-badcat's MiniCPM branch.
# MiniCPM is sharded across both cards; Zipformer uses GPU 0 and VieNeu GPU 1.
# Copy to .env.a100 and source it before setup/a100_minicpm_server.py.

CUDA_VISIBLE_DEVICES=0,1
FDBBADCAT_GPUS=0,1
FDBBADCAT_ASR_GPU=0
FDBBADCAT_TTS_GPU=1
# 0 = automatic per-card budget (total VRAM minus 10 GiB headroom).
FDBBADCAT_MLLM_MAX_MEMORY_GIB=0
MINICPM_MODEL_ID=openbmb/MiniCPM-o-4_5
MINICPM_DTYPE=bfloat16
HF_HOME=/workspace/huggingface

ASR_MODEL_DIR=/workspace/models/zipformer-30m-rnnt-streaming-6000h
ASR_REPO_ID=hynt/Zipformer-30M-RNNT-Streaming-6000h
ASR_EXECUTION_PROVIDER=cuda
ASR_CUDA_DEVICE=0
ASR_CHUNK_SIZE=32
ASR_LEFT_CONTEXT=128
ASR_CPU_THREADS=2
ASR_TAIL_PADDING_MS=660
ASR_LOCAL_FILES_ONLY=false

# VieNeu must be running separately on GPU 1 or another host.
TTS_URL=http://127.0.0.1:19100
TTS_VOICE=
TTS_HEALTH_TIMEOUT=10
TTS_WARMUP=1
TTS_MAX_CONCURRENT_STREAMS=1

DUPLEX_MODE=vad_segment
VAD_SEGMENT_ENDPOINT_MS=640
VAD_LONG_INTERRUPT_SECONDS=1.5
VAD_SPEAK_FALLBACK_SWITCH_SECONDS=0.6
VAD_LISTEN_CONTINUE_TIMEOUT_SECONDS=2.5
MLLM_LIVE_PREFILL=0
MLLM_WARMUP_DUPLEX_WRAPPER=0
MLLM_RESPONSE_PROMPT_VERSION=vi_benchmark_v1
TRACE_ENABLED=1
TRACE_DIR=traces
TRACE_INCLUDE_TEXT=0

# Backend and benchmark runner defaults.
FDBBADCAT_HOST=0.0.0.0
FDBBADCAT_PORT=18000
FDB_WS_URL=ws://127.0.0.1:18000/realtime
